# Postgres на Neon (см. DEPLOY.md): пул соединений и прямое подключение
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Пароль админки /admin (логин admin по умолчанию, можно задать ADMIN_USER)
ADMIN_PASSWORD=

# E-mail владельца сайта для страницы /privacy (RODO)
CONTACT_EMAIL=
